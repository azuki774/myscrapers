#!/usr/bin/env bash
# myscraper: podman/docker wrapper for the myscrapers container.
#
# Mounts a host-side cookie.json into /data/cookie.json so the Go
# myscraper binary (default --cookie-path) can load it without
# the caller having to remember the -v flag.
#
# Any extra arguments are forwarded verbatim to the myscraper
# binary inside the container. With no extra args the container
# falls back to the Dockerfile CMD (moneyforward --fetch --s3-upload).
set -euo pipefail

print_help() {
  cat <<'EOF'
myscraper - run the myscrapers container with /data/cookie.json mounted

USAGE:
  myscraper [WRAPPER_OPTS] [-- MYSCRAPER_ARGS...]

WRAPPER OPTIONS:
  --cookie-file PATH     host path to cookie.json
                         (default: $MYSCRAPER_COOKIE, then
                         $XDG_CONFIG_HOME/myscraper/cookie.json,
                         then $HOME/.config/myscraper/cookie.json,
                         then ./cookie.json)
  --runtime CMD          container runtime (default: podman)
  --image NAME           container image (default: myscrapers:latest)
  --env KEY=VAL          extra -e KEY=VAL (repeatable)
  --keep                 do not pass --rm to the runtime
  --print                print the resolved podman command and exit
  -h, --help             show this help

ENVIRONMENT:
  MYSCRAPER_COOKIE       default for --cookie-file
  MYSCRAPER_RUNTIME      default for --runtime
  MYSCRAPER_IMAGE        default for --image

EXAMPLES:
  # run the default CMD with the auto-discovered cookie
  myscraper

  # override cookie path and run --update
  myscraper --cookie-file ~/secrets/mf-cookie.json --update

  # pass extra env, e.g. S3 bucket
  MYSCRAPER_EXTRA_ENV='-e BUCKET_NAME=my-bucket -e REMOTE_DIR=mf' \
    myscraper --env BUCKET_NAME=my-bucket

  # dry-run: print the command that would be executed
  myscraper --print -- moneyforward --fetch
EOF
}

log_err() { printf 'myscraper: %s\n' "$*" >&2; }

resolve_cookie() {
  local candidate
  for candidate in "$COOKIE_FILE" \
                   "${MYSCRAPER_COOKIE:-}" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/myscraper/cookie.json" \
                   "$HOME/.config/myscraper/cookie.json" \
                   "./cookie.json"; do
    [[ -z "$candidate" ]] && continue
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# ---- defaults (overridable via env) ----
RUNTIME="${MYSCRAPER_RUNTIME:-podman}"
IMAGE="${MYSCRAPER_IMAGE:-myscrapers:latest}"
COOKIE_FILE=""
KEEP=0
PRINT_ONLY=0
EXTRA_ENV=()
MYSCRAPER_ARGS=()

# ---- parse wrapper args (everything after `--` is forwarded) ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) print_help; exit 0 ;;
    --cookie-file) COOKIE_FILE="${2:-}"; shift 2 ;;
    --cookie-file=*) COOKIE_FILE="${1#*=}"; shift ;;
    --runtime) RUNTIME="${2:-}"; shift 2 ;;
    --runtime=*) RUNTIME="${1#*=}"; shift ;;
    --image) IMAGE="${2:-}"; shift 2 ;;
    --image=*) IMAGE="${1#*=}"; shift ;;
    --env) EXTRA_ENV+=("-e" "${2:?--env requires KEY=VAL}"); shift 2 ;;
    --env=*) EXTRA_ENV+=("-e" "${1#*=}"); shift ;;
    --keep) KEEP=1; shift ;;
    --print) PRINT_ONLY=1; shift ;;
    --) shift; MYSCRAPER_ARGS=("$@"); break ;;
    -*)
      log_err "unknown wrapper option: $1"
      log_err "use --help"
      exit 64
      ;;
    *)
      MYSCRAPER_ARGS=("$@")
      break
      ;;
  esac
done

if ! command -v "$RUNTIME" >/dev/null 2>&1; then
  log_err "container runtime '$RUNTIME' not found in PATH"
  exit 127
fi

if ! COOKIE_HOST=$(resolve_cookie); then
  log_err "could not find cookie.json on the host"
  log_err "looked in:"
  log_err "  - --cookie-file / \$MYSCRAPER_COOKIE"
  log_err "  - \$XDG_CONFIG_HOME/myscraper/cookie.json"
  log_err "  - \$HOME/.config/myscraper/cookie.json"
  log_err "  - ./cookie.json"
  exit 66
fi

# Absolute host path so the bind works regardless of the caller's cwd.
COOKIE_HOST_ABS=$(cd "$(dirname -- "$COOKIE_HOST")" && pwd)/$(basename -- "$COOKIE_HOST")

CMD=("$RUNTIME" "run")
[[ $KEEP -eq 0 ]] && CMD+=("--rm")
CMD+=("-v" "${COOKIE_HOST_ABS}:/data/cookie.json:ro")
CMD+=("-e" "TZ=${TZ:-UTC}")
if [[ ${#EXTRA_ENV[@]} -gt 0 ]]; then
  CMD+=("${EXTRA_ENV[@]}")
fi
CMD+=("$IMAGE")
if [[ ${#MYSCRAPER_ARGS[@]} -gt 0 ]]; then
  CMD+=("${MYSCRAPER_ARGS[@]}")
fi

if [[ $PRINT_ONLY -eq 1 ]]; then
  printf '%q ' "${CMD[@]}"
  printf '\n'
  exit 0
fi

exec "${CMD[@]}"
